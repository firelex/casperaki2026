{
  "name": "@casperaki/song-edit",
  "version": "0.1.0",
  "private": true,
  "description": "Pure song-structure edit reducer (sections, tracks, drum hits, undo/redo), shared by the web editor and the brain's assistant.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@casperaki/song-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9"
  }
}
