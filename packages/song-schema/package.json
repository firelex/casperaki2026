{
  "name": "@casperaki/song-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Casperaki song schema: TS types, Zod schemas, canonical serializer, JSON Schema, and legacy adapters.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vocal-take-input": {
      "types": "./dist/vocal-take-input.d.ts",
      "import": "./dist/vocal-take-input.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./ace-layer": {
      "types": "./dist/ace-layer.d.ts",
      "import": "./dist/ace-layer.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/emit-json-schema.mjs",
    "build:json-schema": "node ./scripts/emit-json-schema.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9"
  }
}
