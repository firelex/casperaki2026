{
  "name": "@casperaki/engine-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Lowers canonical Casperaki Song values into the legacy engine envelope shape consumed by apps/engine-spike's native renderer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@casperaki/arrangement": "workspace:*",
    "@casperaki/song-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9"
  }
}
