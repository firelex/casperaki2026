# API server port (Express)
CASPERAKI_PORT=16400
# Vite dev server port (web UI)
CASPERAKI_CLIENT_PORT=16401

# Where downloaded models are written.
CASPERAKI_DOWNLOAD_DIR=~/models
# Extra comma-separated folders to scan for already-downloaded models.
# Defaults to ~/models, ~/Models, ~/.cache/huggingface/hub
# CASPERAKI_MODEL_DIRS=~/models,/data/models

# Optional Hugging Face token for gated/private repos.
# HF_TOKEN=hf_xxx
