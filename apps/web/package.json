{
  "name": "@casperaki/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Casperaki workbench UI \u2014 modern React scaffold driving the brain (POST /api/songs/generate). Successor to casperaki-fe-rory.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "deps:build": "cd ../../../open_teamsuzie && pnpm --filter \"@teamsuzie/ui...\" --filter \"@teamsuzie/theme...\" build"
  },
  "dependencies": {
    "@casperaki/song-edit": "workspace:*",
    "@casperaki/song-schema": "workspace:*",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@teamsuzie/theme": "link:../../../open_teamsuzie/packages/theme",
    "@teamsuzie/ui": "link:../../../open_teamsuzie/packages/ui",
    "@tonejs/midi": "^2.0.28",
    "abcjs": "^6.7.3",
    "jspdf": "^4.2.1",
    "midi-file": "^1.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.17.0",
    "svg2pdf.js": "^2.9.0",
    "@casperaki/video": "git+https://github.com/firelex/casperaki-video.git#9441cee8c206c146184fd61ec57f1113ddf36e7c",
    "three": "^0.187.0",
    "@pixiv/three-vrm": "^3.6.0",
    "zod": "^4.6.7",
    "three-mesh-bvh": "^0.10.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.5",
    "vitest": "^2.1.9",
    "@types/three": "^0.187.0"
  }
}
